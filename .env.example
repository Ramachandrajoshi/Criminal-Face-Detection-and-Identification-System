# Model Configuration
DEEPFACE_MODEL=ArcFace
DEEPFACE_DETECTOR=retinaface
MATCH_THRESHOLD=0.58

# ArcFace embedding quality
# ARCFACE_NORMALIZATION — must match ArcFace's training recipe.
#   "ArcFace" → (pixel − 127.5) / 128   ← correct, always use this
#   "base"    → pixel / 255              ← wrong for ArcFace, doubles the normalization
# WARNING: changing this invalidates all stored embeddings — re-register all faces.
ARCFACE_NORMALIZATION=ArcFace
# ENABLE_CLAHE — apply per-image illumination normalisation before embedding.
# Recommended: true. Disabling increases same-person cosine distance variance.
ENABLE_CLAHE=true
# CLAHE_CLIP_LIMIT — contrast enhancement aggressiveness (1.0–4.0).
# Lower = more subtle. 2.0 is the standard default.
CLAHE_CLIP_LIMIT=2.0

# Embedding engine for NEW enrollments / re-enrollments
#   3 → DeepFace ArcFace (default)
#   4 → InsightFace buffalo_l on ONNX Runtime — faster, more accurate.
#       Pretrained weights are licensed for NON-COMMERCIAL RESEARCH ONLY.
# Faces enrolled under an older version keep matching after a switch: search
# embeds the query once per version present in the database.
EMBEDDING_VERSION=4
# Cosine-distance threshold for version-4 vectors. PROVISIONAL — calibrate with
#   python backend/scripts/benchmark_engines.py <dataset> --versions 3 4
# and the bias-audit notebook before relying on it (AGENTS.md §8).
MATCH_THRESHOLD_INSIGHTFACE=0.60
INSIGHTFACE_MODEL_DIR=~/.insightface/models/buffalo_l
INSIGHTFACE_AUTO_DOWNLOAD=true
INSIGHTFACE_DET_SIZE=640
INSIGHTFACE_DET_THRESHOLD=0.5
# Cap on the ONNX Runtime CUDA memory arena (MB).
INSIGHTFACE_GPU_MEM_LIMIT_MB=1536

# Debug face dumps — DEBUG ONLY, never in production.
# DEBUG_FACE_DUMP=true writes the face image after every pipeline stage
# (detect → crop → each enhancement step → final 112×112) plus a
# manifest.json of lighting stats and match distances, one folder per
# register / search / pose request. This stores raw face images on disk
# (AGENTS.md §15): delete the folder when you are done.
# In Docker, /app/debug_faces is bind-mounted to ./debug_faces on the host.
DEBUG_FACE_DUMP=false
DEBUG_FACE_DUMP_DIR=/app/debug_faces

# Database
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=criminaldb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=replace-with-strong-db-password
DB_ENCRYPTION_KEY=base64-encoded-32-byte-key

# API
JWT_SECRET=replace-with-strong-secret-in-production
JWT_EXPIRY_HOURS=8
API_HOST=0.0.0.0
API_PORT=8000
DEFAULT_TENANT_ID=1

# Admin auth
# IMPORTANT: keep the single-quotes around the hash — bcrypt hashes contain '$'
# characters that shells expand to empty strings when unquoted, causing an
# "Invalid salt" error at login. Generate a fresh hash with:
#   python backend/scripts/hash_password.py
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='$2b$12$.hm8YqiPyGINlWt8tKj0DONkCtOIRvyQAD4x7FfW.jDefAOfHa4D.'
ALLOW_ADMIN_INIT=false

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# GPU Acceleration
# ENABLE_GPU=true  — set to false to force CPU-only mode (e.g. on machines
#                     without an NVIDIA GPU or without nvidia-docker2 installed)
ENABLE_GPU=true
# TF_GPU_MEMORY_LIMIT_MB — hard VRAM cap for TensorFlow / DeepFace (MB).
#   0 → no cap (memory growth; TF can keep growing on a large card).
# Budget example for a 5 GB slice of a shared GPU:
#   TF_GPU_MEMORY_LIMIT_MB=3072 + INSIGHTFACE_GPU_MEM_LIMIT_MB=1536
#   + ~0.4 GB shared CUDA context ≈ 5 GB. Verify with nvidia-smi under load.
TF_GPU_MEMORY_LIMIT_MB=0
# GPU_MEMORY_FRACTION — not read by the backend; use TF_GPU_MEMORY_LIMIT_MB.
GPU_MEMORY_FRACTION=0.8
# NVIDIA_VISIBLE_DEVICES — which physical GPU(s) to expose to the container.
#   1        → second GPU only  (default — leaves GPU 0 free for other workloads)
#   0        → first GPU only
#   0,1      → both GPUs
#   all      → all GPUs
# Must match the device_ids value in docker-compose.yml.
NVIDIA_VISIBLE_DEVICES=1
