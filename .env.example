# Model Configuration
DEEPFACE_MODEL=ArcFace
DEEPFACE_DETECTOR=retinaface
MATCH_THRESHOLD=0.58

# Database
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=criminaldb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=replace-with-strong-db-password
DB_ENCRYPTION_KEY=base64-encoded-32-byte-key

# API
JWT_SECRET=replace-with-strong-secret-in-production
JWT_EXPIRY_HOURS=8
API_HOST=0.0.0.0
API_PORT=8000

# Admin auth
# IMPORTANT: keep the single-quotes around the hash — bcrypt hashes contain '$'
# characters that shells expand to empty strings when unquoted, causing an
# "Invalid salt" error at login. Generate a fresh hash with:
#   python backend/scripts/hash_password.py
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='$2b$12$.hm8YqiPyGINlWt8tKj0DONkCtOIRvyQAD4x7FfW.jDefAOfHa4D.'
ALLOW_ADMIN_INIT=false

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# GPU Acceleration
# ENABLE_GPU=true  — set to false to force CPU-only mode (e.g. on machines
#                     without an NVIDIA GPU or without nvidia-docker2 installed)
ENABLE_GPU=true
# GPU_MEMORY_FRACTION — fraction of VRAM TensorFlow may use (0.0–1.0).
# Reduce if other processes need to share the GPU (e.g. 0.5 = 50% VRAM).
GPU_MEMORY_FRACTION=0.8
# NVIDIA_VISIBLE_DEVICES — which physical GPU(s) to expose to the container.
#   1        → second GPU only  (default — leaves GPU 0 free for other workloads)
#   0        → first GPU only
#   0,1      → both GPUs
#   all      → all GPUs
# Must match the device_ids value in docker-compose.yml.
NVIDIA_VISIBLE_DEVICES=1
